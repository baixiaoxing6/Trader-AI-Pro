{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 1,
  "fee": 0.0006,
  "futures_funding_rate": 0.0,
  "exchange": {
    "pair_whitelist": [
      "SOL/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "freqai": {
    "identifier": "trader-ai-pro-ci-smoke-v1",
    "purge_old_models": 2,
    "train_period_days": 1,
    "backtest_period_days": 1,
    "save_backtest_models": false,
    "feature_parameters": {
      "include_timeframes": [
        "5m",
        "15m"
      ],
      "include_corr_pairlist": [],
      "label_period_candles": 6,
      "include_shifted_candles": 1,
      "indicator_periods_candles": [
        10,
        20
      ],
      "DI_threshold": 0.9,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "plot_feature_importances": 0
    },
    "data_split_parameters": {
      "test_size": 0.2,
      "random_state": 42,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 50,
      "learning_rate": 0.05,
      "max_depth": 4,
      "num_leaves": 15,
      "random_state": 42,
      "n_jobs": -1
    }
  }
}
