{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "Trader AI Pro Signal",
  "strategy": "TraderAIProSignalStrategy",
  "strategy_path": "user_data/strategies",
  "timeframe": "5m",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "cancel_open_orders_on_exit": true,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "liquidation_buffer": 0.05,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "market",
    "force_exit": "market",
    "force_entry": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false,
    "stoploss_price_type": "mark"
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "exchange": {
    "name": "bybit",
    "api_key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true
    },
    "ccxt_async_config": {
      "enableRateLimit": true
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "freqai": {
    "enabled": true,
    "identifier": "trader-ai-pro-signal-v1",
    "purge_old_models": 2,
    "train_period_days": 30,
    "backtest_period_days": 7,
    "save_backtest_models": false,
    "live_retrain_hours": 1,
    "feature_parameters": {
      "include_timeframes": [
        "5m",
        "15m",
        "1h"
      ],
      "include_corr_pairlist": [
        "BTC/USDT:USDT",
        "ETH/USDT:USDT"
      ],
      "label_period_candles": 12,
      "include_shifted_candles": 2,
      "indicator_periods_candles": [
        10,
        20,
        50
      ],
      "DI_threshold": 0.9,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "plot_feature_importances": 0
    },
    "data_split_parameters": {
      "test_size": 0.25,
      "random_state": 42,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 300,
      "learning_rate": 0.03,
      "max_depth": 6,
      "num_leaves": 31,
      "random_state": 42,
      "n_jobs": -1
    }
  },
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": "",
    "allow_custom_messages": true,
    "notification_settings": {
      "status": "silent",
      "warning": "on",
      "startup": "on",
      "entry": "on",
      "entry_fill": "off",
      "entry_cancel": "off",
      "exit": {
        "*": "on"
      },
      "exit_cancel": "off",
      "exit_fill": "off",
      "protection_trigger": "on",
      "protection_trigger_global": "on",
      "strategy_msg": "on",
      "show_candle": "ohlc"
    },
    "reload": true
  },
  "api_server": {
    "enabled": false
  },
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5,
    "heartbeat_interval": 60
  }
}
